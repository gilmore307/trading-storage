[Unit]
Description=Refresh trading dashboard read-model summaries
Documentation=file:/root/projects/trading-storage/docs/41_dashboard_summary_layout.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=TRADING_STORAGE_ROOT=/root/projects/trading-storage
Environment=TRADING_STORAGE_DATA_ROOT=/root/projects/trading-storage/storage
Environment=TRADING_MANAGER_ROOT=/root/projects/trading-manager
Environment=TRADING_STORAGE_REFRESH_CADENCE_SECONDS=60
Environment=VIRTUAL_ENV=/root/projects/trading-manager/.venv
Environment=PATH=/root/projects/trading-manager/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/default/trading-storage-dashboard-read-model-refresh
WorkingDirectory=/root/projects/trading-storage
ExecStart=/usr/bin/env PYTHONPATH=${TRADING_STORAGE_ROOT}/src python ${TRADING_STORAGE_ROOT}/scripts/dashboard/refresh_public_dashboard_read_models.py --trading-manager-root ${TRADING_MANAGER_ROOT} --storage-root ${TRADING_STORAGE_DATA_ROOT}
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
