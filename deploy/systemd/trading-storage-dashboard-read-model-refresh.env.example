# Environment overrides for trading-storage-dashboard-read-model-refresh.service
# Copy to /etc/default/trading-storage-dashboard-read-model-refresh and review before enabling the timer.

TRADING_STORAGE_ROOT=/root/projects/trading-storage
TRADING_STORAGE_DATA_ROOT=/root/projects/trading-storage/storage
TRADING_MANAGER_ROOT=/root/projects/trading-manager
TRADING_SECRET_ROOT=/root/secrets
TRADING_STORAGE_REFRESH_CADENCE_SECONDS=60
