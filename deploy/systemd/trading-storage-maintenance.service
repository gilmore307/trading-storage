[Unit]
Description=Run trading-storage scheduled maintenance
Documentation=file:/root/projects/trading-storage/docs/20_storage_lifecycle_policy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=TRADING_STORAGE_ROOT=/root/projects/trading-storage
Environment=TRADING_STORAGE_MAINTENANCE_OUTPUT=storage/maintenance/storage_maintenance_summary.json
Environment=TRADING_STORAGE_MAINTENANCE_LOCAL_RETENTION_ARGS=--apply-local-retention
EnvironmentFile=-/etc/default/trading-storage-maintenance
WorkingDirectory=/root/projects/trading-storage
ExecStart=/usr/bin/env PYTHONPATH=${TRADING_STORAGE_ROOT}/src python3 ${TRADING_STORAGE_ROOT}/scripts/lifecycle/run_storage_maintenance.py --root ${TRADING_STORAGE_ROOT} --output-path ${TRADING_STORAGE_MAINTENANCE_OUTPUT} ${TRADING_STORAGE_MAINTENANCE_LOCAL_RETENTION_ARGS}
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
