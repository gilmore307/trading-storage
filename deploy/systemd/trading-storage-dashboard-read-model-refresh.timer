[Unit]
Description=Periodic trading dashboard read-model refresh
Documentation=file:/root/projects/trading-storage/docs/41_dashboard_summary_layout.md

[Timer]
OnBootSec=2min
OnUnitActiveSec=60s
AccuracySec=1s
Persistent=true
Unit=trading-storage-dashboard-read-model-refresh.service

[Install]
WantedBy=timers.target
