[Unit]
Description=Apply trading-storage local retention policy
Documentation=file:/root/projects/trading-storage/docs/02_architecture.md

[Service]
Type=oneshot
WorkingDirectory=/root/projects/trading-storage
Environment=PYTHONPATH=/root/projects/trading-storage/src
ExecStart=/usr/bin/python3 /root/projects/trading-storage/scripts/lifecycle/maintain_local_storage.py --root /root/projects/trading-storage --apply
